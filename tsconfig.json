{
  // Le projet est en JavaScript. TypeScript est utilisé ici comme *vérificateur de
  // types*, pas comme langage : `tsc --noEmit` ne produit aucun fichier.
  //
  // Stratégie d'adoption incrémentale (cf. docs/ai/coding-rules.md) :
  //   - `checkJs: false` globalement — on ne casse pas la CI d'un coup.
  //   - Chaque fichier qui ajoute `// @ts-check` en tête est vérifié strictement.
  //   - Toute nouvelle logique métier / helper / adaptateur DOIT porter `// @ts-check`.
  //   - Objectif : passer `checkJs: true` une fois la majorité des fichiers annotés.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "*.config.js", "vite.config.js"],
  "exclude": ["node_modules", "dist", "coverage", "e2e", "_bmad", "_bmad-output"]
}
